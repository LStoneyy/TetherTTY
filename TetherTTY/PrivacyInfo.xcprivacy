<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- TetherTTY does not track users and runs no analytics/telemetry. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>

    <!-- No data is collected or transmitted off-device. Connection metadata
         (host, username, alias), host-key fingerprints, and app state are
         stored only locally; SSH passwords live only in the Keychain. -->
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- Required-reason API declarations.
         The app persists its own connection list, host-key trust, and app
         state in UserDefaults (access to information stored by the app itself).

         File timestamp APIs (`stat`/`fstat`/`lstat`) are pulled in transitively by the
         statically-linked SwiftNIO dependency (NIOPosix/System.swift, part of the swift-nio
         package used via swift-nio-ssh for the app's SSH transport) and are present as
         undefined symbols in the Release binary (confirmed via `nm -u`), even though TetherTTY's
         own code never calls these APIs directly. -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <!-- stat / fstat / lstat, from swift-nio's NIOPosix (Sources/NIOPosix/System.swift),
                 linked transitively via swift-nio-ssh (NIOCore/NIOPosix products). -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
